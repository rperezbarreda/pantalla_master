<?xml version="1.0" encoding="utf-8"?>
<!-- Sólo internet, y sólo para importar un personaje por su enlace (D&D
     Beyond, Nivel20); todo lo demás va dentro de la app, sin conexión. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="false"
        android:theme="@style/Tema">

        <activity
            android:name=".Principal"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Ventana"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name=".Archivos"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
